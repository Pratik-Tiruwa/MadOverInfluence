{
  "version": 2,
  "buildCommand": "pnpm --filter @workspace/moi-website run build",
  "outputDirectory": "artifacts/moi-website/dist/public",
  "installCommand": "pnpm install",
  "framework": null,
  "functions": {
    "artifacts/moi-website/api/*.ts": {
      "runtime": "@vercel/node@4"
    }
  },
  "rewrites": [
    {
      "source": "/api/contact",
      "destination": "/artifacts/moi-website/api/contact.ts"
    },
    {
      "source": "/api/healthz",
      "destination": "/artifacts/moi-website/api/health.ts"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
