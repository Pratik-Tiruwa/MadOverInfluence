{
  "version": 2,
  "buildCommand": "pnpm --filter @workspace/moi-website run build",
  "devCommand": "pnpm --filter @workspace/moi-website run dev",
  "outputDirectory": "artifacts/moi-website/dist/public",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
